# All paths are relative to the project root unless absolute.
POLICY_DATA_DIR=data
# Leave empty until a provider has been selected. No paid calls occur on startup.
POLICY_CHAT_PROVIDER=
POLICY_CHAT_MODEL=
POLICY_CHAT_BASE_URL=
POLICY_CHAT_API_KEY=
# Optional provider-specific JSON. DeepSeek: {"thinking":{"type":"disabled"}}
POLICY_CHAT_EXTRA_BODY={}
# Embedding provider/model are independent from the chat model.
POLICY_EMBEDDING_PROVIDER=
POLICY_EMBEDDING_MODEL=
POLICY_EMBEDDING_BASE_URL=
POLICY_EMBEDDING_API_KEY=
POLICY_EMBEDDING_BATCH_SIZE=10
POLICY_MAX_SEARCH_CALLS=3
POLICY_HISTORY_TURNS=6
# keyword works without embedding credentials; hybrid requires policy-agent embed.
POLICY_RETRIEVAL_MODE=keyword
