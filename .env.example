# Only a tool-capable chat model is required. No paid calls occur on startup.
POLICY_CHAT_PROVIDER=
POLICY_CHAT_MODEL=
POLICY_CHAT_BASE_URL=
POLICY_CHAT_API_KEY=
# Optional provider-specific JSON, for example {"thinking":{"type":"disabled"}}
POLICY_CHAT_EXTRA_BODY={}
# Explicit total context capacity is recommended for custom/compatible endpoints.
# 0 uses the LangChain profile when available, otherwise a 32768-token fallback.
POLICY_CHAT_CONTEXT_WINDOW_TOKENS=0
POLICY_CHAT_MAX_OUTPUT_TOKENS=2048
POLICY_CHAT_CONTEXT_MARGIN_TOKENS=512
# HEAD follows the upstream default branch; each question pins one immutable commit.
# Use a full commit SHA for repeatable evaluations.
POLICY_GITHUB_REF=HEAD
# Optional: read-only GitHub token to increase public REST API limits. Keep private.
POLICY_GITHUB_TOKEN=
POLICY_MAX_POLICY_READS=6
POLICY_READ_MAX_CHARS=24000
